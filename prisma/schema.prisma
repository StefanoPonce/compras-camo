// Esquema de la base de datos — Sistema de compras Fundación CAMO
// Ejecuta:  npx prisma migrate dev --name inicial
// para crear las tablas en PostgreSQL a partir de este archivo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Los 5 roles del sistema y lo que cada uno puede hacer.
// La matriz de permisos vive en src/lib/permisos.ts — aquí solo el nombre.
enum Rol {
  administrador
  sub_administrador
  jefe_inmediato
  responsable_gestion
  responsable_solicitante
}

enum EstadoOrden {
  Pendiente
  Aprobada
  Rechazada
  Recibida
  // Requisición a medio llenar: guarda lo que ya se escribió y se sigue
  // completando más tarde. No pasa por revisión ni suma al inventario hasta
  // que su autor la envía. Solo su autor la ve.
  Borrador
}

// Estado de compra de un renglón de requisición. Lo elige quien gestiona:
//   Pendiente   → Pendiente de Compra (nace así y pasa al módulo Compras)
//   Gestionado  → ya se resolvió por fuera, no necesita compra
//   Entregado   → lo puso Compras cuando llegó el material; cuando TODOS los
//                 renglones de una requisición quedan Entregados, la
//                 requisición sola pasa a Recibida (ver actions.ts)
enum EstadoGestion {
  Pendiente
  Gestionado
  Entregado
}

model Usuario {
  id             Int           @id @default(autoincrement())
  usuario        String        @unique
  claveHash      String
  nombre         String
  correo         String?
  rol            Rol           @default(responsable_solicitante)
  // "__rol__" significa que el usuario hereda los módulos de su rol.
  // Una lista vacía significa que no tiene módulos personalizados habilitados.
  modulosPermitidos String[]   @default(["__rol__"])
  activo         Boolean       @default(true)
  ultimoIngreso  DateTime?
  // Token de la única sesión activa. Si otro dispositivo intenta entrar,
  // el servidor rechaza el nuevo inicio de sesión hasta que se cierre la
  // existente o expire por inactividad.
  sesionToken    String?
  sesionExpira   DateTime?
  creadoEn       DateTime      @default(now())

  ordenesPedidas OrdenCompra[] @relation("solicitante")
  ordenesRevisadas OrdenCompra[] @relation("revisor")
  ordenesRecibidas OrdenCompra[] @relation("receptor")
  movimientos    Movimiento[]
  descargos      DescargoInventario[]

  @@map("usuarios")
}

model Proveedor {
  id         Int         @id @default(autoincrement())
  // Código interno del proveedor. El Excel de la fundación trae la columna
  // vacía, así que la seed genera códigos ficticios (PROV-001, PROV-002…).
  codigo       String?    @unique
  nombre     String
  rtn        String?     @unique
  contacto   String?
  telefono   String?
  correo     String?
  direccion  String?
  // Tipo de producto que maneja el proveedor (viene en el Excel).
  tipoProducto String?
  // Cuenta en la que la fundación deposita a este proveedor. Se guarda como
  // texto para admitir guiones y espacios tal como lo da el banco.
  cuentaBancaria String?
  activo     Boolean     @default(true)
  creadoEn   DateTime    @default(now())

  materiales Material[]
  ordenes    OrdenCompra[]
  detalles    DetalleOrden[]

  @@map("proveedores")
}

model Material {
  id            Int             @id @default(autoincrement())
  codigo        String          @unique
  nombre        String
  categoria     String          @default("General")
  unidad        String          @default("Unidad")

  // La presentación va dentro del nombre ("BOLSA PLASTICA 4X8", "AGUA 12 ONZ"):
  // antes había familia y variante, pero eran un dato redundante que nadie iba
  // a mantener. Ver prisma/migracion-sin-familia-variante.sql.

  existencia    Int             @default(0)
  minimo        Int             @default(0)
  // La columna "precioUltimo" sigue existiendo en la tabla "materiales" pero
  // el sistema ya no la usa: la fundación maneja los precios por fuera.
  activo        Boolean         @default(true)
  creadoEn      DateTime        @default(now())

  // URL pública de la foto del producto guardada en Supabase Storage
  // (bucket "materiales"). Null cuando el material todavía no tiene imagen.
  imagenUrl     String?

  proveedorId   Int?
  proveedor     Proveedor?      @relation(fields: [proveedorId], references: [id])

  detalles      DetalleOrden[]
  descargos     DescargoInventario[]

  @@map("materiales")
}

model OrdenCompra {
  id             Int            @id @default(autoincrement())
  folio          String         @unique
  fecha          DateTime       @default(now())
  dependencia    String?
  // Área que pide el material (Salud, Laboratorio, Facturación…): se escribe
  // libremente en el formulario y se muestra arriba de la requisición cuando
  // se visualiza.
  area           String?
  lugar          String?
  justificacion  String?
  // El programa ya NO es de la requisición: ahora va en cada renglón de
  // detalle_orden, porque una requisición puede llevar materiales de varios
  // programas. Esta columna sigue existiendo en la tabla (guarda el valor
  // viejo) pero el sistema ya no la escribe. Para mostrar el programa de una
  // requisición se toman los de sus renglones.
  estado         EstadoOrden    @default(Pendiente)
  // La columna "total" sigue existiendo en la tabla "ordenes_compra" pero el
  // sistema ya no la usa: la fundación maneja los precios por fuera.
  fechaRevision  DateTime?
  fechaRecepcion DateTime?
  comentario     String?
  creadoEn       DateTime       @default(now())

  // El proveedor se elige al enviar la requisición. Un borrador puede quedar
  // sin él, porque se guarda antes de haber llenado todo el formulario: es
  // normal empezar por los materiales. Enviar la requisición sí lo exige.
  proveedorId    Int?
  proveedor      Proveedor?     @relation(fields: [proveedorId], references: [id])

  solicitanteId  Int
  solicitante    Usuario        @relation("solicitante", fields: [solicitanteId], references: [id])

  revisorId      Int?
  revisor        Usuario?       @relation("revisor", fields: [revisorId], references: [id])

  recibidoPorId  Int?
  recibidoPor    Usuario?       @relation("receptor", fields: [recibidoPorId], references: [id])

  // Nombre de la persona que recibió la entrega, escrito a mano por el sub
  // administrador al registrarla. Es texto libre (quien recibe no siempre
  // tiene cuenta en el sistema) y es lo que aparece impreso en la hoja.
  recibidoPorTxt String?

  items          DetalleOrden[]

  @@map("ordenes_compra")
}

model DetalleOrden {
  id          Int         @id @default(autoincrement())
  cantidad    Int

  // Unidad en la que se pide ESTE renglón. El catálogo tiene la suya, pero el
  // solicitante puede cambiarla si va a comprar distinto (por ejemplo, el
  // material está en UNIDAD y se pide un ROLLO). Se guarda siempre en la forma
  // canónica que define src/lib/unidades.ts.
  unidad      String       @default("UNIDAD")

  // Programa al que se carga ESTE renglón. Antes el programa era de toda la
  // requisición; ahora es por material porque una misma requisición puede
  // llevar materiales de varios programas. Guarda el código corto ("2.2") y
  // el nombre se resuelve con src/lib/programas.ts.
  programa    String?

  // Archivo que adjunta el solicitante para este renglón: una foto o un
  // documento (PDF). Vive en el bucket "requisiciones" de Supabase Storage.
  // La foto del catálogo del material NO se guarda aquí, vive en Material.
  adjuntoUrl     String?
  adjuntoNombre  String?

  // La columna "precio" sigue existiendo en la tabla "detalle_orden" pero el
  // sistema ya no la usa: la fundación maneja los precios por fuera. Es NOT
  // NULL en la base, así que la migración le pone un default para que los
  // INSERT sigan funcionando aunque Prisma ya no la envíe.

  // Proveedor elegido para ESTE renglón en el formulario (la orden guarda
  // además uno propio, que es el del primer renglón con proveedor). En las
  // órdenes viejas queda null y la impresión cae al proveedor de la orden.
  proveedorId Int?
  proveedor   Proveedor?  @relation(fields: [proveedorId], references: [id])

  ordenId     Int
  orden       OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  materialId  Int
  material    Material    @relation(fields: [materialId], references: [id])

  // Estado de compra de ESTE renglón. Nace Pendiente: en Gestión se marca
  // Gestionado o Pendiente de Compra y en Compras se agrega Entregado. Es por
  // renglón (no por material) para que cada requisición lleve su propio
  // avance y pueda alimentarse sola.
  estadoGestion EstadoGestion @default(Pendiente)

  // El solicitante confirma, producto por producto, que ya le llegó el
  // material. Es una marca informativa: NO toca el inventario ni cambia el
  // estado de la requisición (la recepción formal con la suma a la existencia
  // la sigue registrando el sub administrador con "Registrar entrega"). Solo
  // la pone el solicitante de ESTA requisición.
  recibidoSolicitante   Boolean   @default(false)
  // Cuándo la puso: queda vacío mientras no se haya confirmado.
  recibidoSolicitanteEn DateTime?

  // ¿Este renglón ya se sumó a la existencia? Solo suma quien registra la
  // entrega y solo cuenta lo que NO está "Pendiente de Compra" (Gestionado y
  // ENTREGADO sí). La marca evita contar dos veces cuando la entrega llega en
  // partes: cada pase suma los renglones resueltos que falten.
  inventariado     Boolean   @default(false)
  // Cuándo entró a la existencia; vacío si todavía no se ha contado.
  inventariadoEn   DateTime?

  @@map("detalle_orden")
}

// Salida de productos del bodega: cada vez que alguien resta existencia
// queda un renglón aquí con cuánto había, cuánto se llevó y quién lo hizo.
// La existencia nueva se guarda en la columna correspondiente para tener
// el histórico aunque después se agregue más stock al material.
model DescargoInventario {
  id                Int       @id @default(autoincrement())
  fecha             DateTime  @default(now())
  cantidad          Int
  motivo            String?
  existenciaAntes   Int
  existenciaDespues Int

  materialId        Int
  material          Material  @relation(fields: [materialId], references: [id])

  usuarioId         Int
  usuario           Usuario   @relation(fields: [usuarioId], references: [id])

  @@map("descargos_inventario")
}

model Movimiento {
  id          Int       @id @default(autoincrement())
  fecha       DateTime  @default(now())
  usuarioTxt  String
  rolTxt      String
  modulo      String
  accion      String
  detalle     String?

  usuarioId   Int?
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])

  @@map("movimientos")
}
